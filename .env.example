# ─── ZURION Store — variables d'environnement ───────────────────────────
# Copier ce fichier vers .env puis adapter les valeurs.
# Aucun secret réel ne doit être versionné.

# Port HTTP du serveur
PORT=4173

# URL de la base de données.
# En développement : SQLite (fichier local, aucun service requis)
DATABASE_URL=sqlite://./data/zurion.sqlite
# En production PostgreSQL :
# DATABASE_URL=postgres://user:password@host:5432/zurion

# Clé secrète de signature des sessions JWT — GÉNÉRER une valeur longue et aléatoire :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Durée de vie du cookie de session (en jours)
SESSION_MAX_AGE_DAYS=7

# Mode « production » : actif pour restreindre certains comportements de debug
NODE_ENV=development

# Limites anti-abus (requêtes par fenêtre)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Vérification du certificat TLS PostgreSQL en production.
# Mettre false uniquement si l'hébergeur fournit un certificat non signé par
# une autorité reconnue et que cette exception est explicitement nécessaire.
DB_SSL_ENABLED=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Ne jamais activer en production avant l'intégration d'un prestataire réel.
ALLOW_SIMULATED_PAYMENTS=false