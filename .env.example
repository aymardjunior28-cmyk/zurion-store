# Copier ce fichier vers .env pour la configuration locale.
# En production, définir ces variables dans la plateforme d'hébergement
# (Render, Docker…), jamais dans le dépôt.

NODE_ENV=development
PORT=4173

# SQLite par défaut en développement. En production : chaîne PostgreSQL.
DATABASE_URL=sqlite://./data/zurion.sqlite

# Secret JWT — obligatoire et OBLIGATOIREMENT unique en production.
JWT_SECRET=dev-secret-change-me-a-very-long-random-value-0123456789

# Nom du cookie de session (harmonisé avec le code — ne pas dériver).
COOKIE_NAME=zurion_token

SESSION_MAX_AGE_DAYS=7
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# TLS vers la base (utile pour bases cloud type Render/Supabase).
DB_SSL_ENABLED=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Paiements simulés : 'true' en développement, 'false' en production.
ALLOW_SIMULATED_PAYMENTS=true