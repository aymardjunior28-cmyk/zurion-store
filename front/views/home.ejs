<section class="zurion-hero">
  <video class="zurion-hero__video" autoplay muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1">
    <source src="/Video4.mp4" type="video/mp4">
    Votre navigateur ne supporte pas la lecture de vidéos.
  </video>
  <div class="container zurion-hero__inner">
    <div class="zurion-hero__content">
      <p class="zurion-eyebrow">TECHNOLOGIE, SANS COMPLICATION</p>
      <h1>Le quotidien,<br>en mieux connecté.</h1>
      <p>Une sélection ZURION pensée pour mieux écouter, travailler, jouer et rester en mouvement.</p>
      <a href="/catalogue" class="btn btn-primary zurion-hero__cta">Explorer le store</a>
    </div>
  </div>
  <div class="zurion-trustbar container">
    <div><i class="fa-solid fa-truck-fast"></i><p><strong>Livraison suivie</strong><span>De la commande à la réception.</span></p></div>
    <div><i class="fa-solid fa-shield-halved"></i><p><strong>Paiement sécurisé</strong><span>Des options adaptées à vos usages.</span></p></div>
    <div><i class="fa-solid fa-headset"></i><p><strong>Support ZURION</strong><span>Une équipe disponible pour vous aider.</span></p></div>
    <div><i class="fa-solid fa-certificate"></i><p><strong>Garantie 12 mois</strong><span>Sur toute la boutique.</span></p></div>
  </div>
</section>

<div class="container">
  <!-- Catégories -->
  <section class="zurion-section">
    <div class="zurion-section__head">
      <div>
        <h2>Choisissez votre univers</h2>
        <p>Les essentiels technologiques pour chaque moment.</p>
      </div>
      <a href="/catalogue">Voir tout <i class="fa-solid fa-arrow-right-long"></i></a>
    </div>
    <div class="zurion-categories">
      <% categories.forEach(c => { %>
        <a href="/catalogue?category=<%= c.slug %>" class="zurion-category">
          <img src="<%= safeImageUrl(c.image) %>" alt="<%- esc(c.name) %>" loading="lazy">
          <strong><%- esc(c.name) %></strong>
          <span><%= (c.description || '').slice(0, 60) %></span>
        </a>
      <% }) %>
    </div>
  </section>

  <!-- Promotions -->
  <section class="zurion-section">
    <div class="zurion-section__head">
      <div>
        <h2>Offres du moment</h2>
        <p>Des prix ZURION sur les essentiels.</p>
      </div>
      <a href="/catalogue">Toute la sélection <i class="fa-solid fa-arrow-right-long"></i></a>
    </div>
    <div class="zurion-grid zurion-grid--4">
      <% promos.forEach(p => { %>
        <%- include('partials/product-card', { product: p }) %>
      <% }) %>
    </div>
  </section>

  <!-- Nouveautés -->
  <section class="zurion-section">
    <div class="zurion-section__head">
      <div>
        <h2>Nouveautés</h2>
        <p>Les derniers arrivés dans le store.</p>
      </div>
      <a href="/catalogue?sort=newest">Découvrir <i class="fa-solid fa-arrow-right-long"></i></a>
    </div>
    <div class="zurion-grid zurion-grid--4">
      <% newArrivals.forEach(p => { %>
        <%- include('partials/product-card', { product: p }) %>
      <% }) %>
    </div>
  </section>

  <!-- Bannière réassurance type Oraimo -->
  <section class="zurion-banner" aria-label="Pourquoi nous faire confiance">
    <div class="zurion-banner__content">
      <p class="zurion-banner__eyebrow"><i class="fa-solid fa-shield-heart"></i> Votre confiance, notre priorité</p>
      <h2>La technologie ZURION,<br>une confiance qui se construit</h2>
      <p class="zurion-banner__lead">
        Des produits rigoureusement sélectionnés, livrés partout en Côte d’Ivoire et protégés par une garantie de 12&nbsp;mois.
        Plus qu’une boutique, ZURION est un partenaire qui vous accompagne avant, pendant et après chaque achat.
      </p>
      <div class="zurion-banner__cta">
        <a href="/catalogue" class="btn btn-light btn-lg">Découvrir la boutique <i class="fa-solid fa-arrow-right-long"></i></a>
        <a href="/livraison" class="zurion-banner__link">Livraison &amp; retours <i class="fa-solid fa-angle-right"></i></a>
      </div>
    </div>
    <div class="zurion-banner__stats">
      <div class="zurion-banner__stat">
        <span class="zurion-banner__stat-icon"><i class="fa-solid fa-users"></i></span>
        <strong>50&nbsp;000+</strong>
        <span>Clients équipés</span>
      </div>
      <div class="zurion-banner__stat">
        <span class="zurion-banner__stat-icon"><i class="fa-solid fa-layer-group"></i></span>
        <strong>8</strong>
        <span>Univers produits</span>
      </div>
      <div class="zurion-banner__stat">
        <span class="zurion-banner__stat-icon"><i class="fa-solid fa-certificate"></i></span>
        <strong>12&nbsp;mois</strong>
        <span>De garantie</span>
      </div>
      <div class="zurion-banner__stat">
        <span class="zurion-banner__stat-icon"><i class="fa-solid fa-star"></i></span>
        <strong>4.8/5</strong>
        <span>Satisfaction client</span>
      </div>
    </div>
  </section>
</div>