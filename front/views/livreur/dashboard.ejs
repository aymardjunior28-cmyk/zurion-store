<% const _livs = (typeof livraisons !== 'undefined' && Array.isArray(livraisons)) ? livraisons : []; %>
<% const _stats = { en_cours: 0, livree: 0, annulee: 0 }; %>
<% _livs.forEach((l) => { if (l.status === 'en_cours') _stats.en_cours++; else if (l.status === 'livrée') _stats.livree++; else if (l.status === 'annulée') _stats.annulee++; }); %>
<% const _isInternalMsg = (typeof currentUser !== 'undefined' && currentUser && ['superadmin','admin','livreur'].includes(currentUser.role)); %>
<div class="livreur-dashboard container py-5">
  <!-- Bandeau d'accueil livreur -->
  <div class="zurion-livreur-hero mb-5">
    <div class="zurion-livreur-hero__row">
      <div class="zurion-livreur-hero__text">
        <p class="zurion-eyebrow zurion-livreur-hero__eyebrow">ESPACE LIVREUR</p>
        <h2>Bonjour, <span class="zurion-livreur-hero__name"><%= currentUser.firstName %></span> <i class="fa-solid fa-motorcycle zurion-livreur-hero__moto"></i></h2>
        <p>Suivez vos livraisons, consultez le détail de chaque colis et échangez avec l'équipe ZURION.</p>
      </div>
      <div class="zurion-livreur-hero__right">
        <span class="zurion-livreur-hero__badge"><i class="fa-solid fa-bell"></i><strong id="unread-count">0</strong> notification(s)</span>
      </div>
    </div>
  </div>

  <!-- Compteurs rapides -->
  <div class="zurion-lv-stats mb-5">
    <div class="zurion-lv-stat zurion-lv-stat--cours">
      <span class="zurion-lv-stat__icon"><i class="fa-solid fa-truck-fast"></i></span>
      <div><strong><%= _stats.en_cours %></strong><small>En cours</small></div>
    </div>
    <div class="zurion-lv-stat zurion-lv-stat--livree">
      <span class="zurion-lv-stat__icon"><i class="fa-solid fa-circle-check"></i></span>
      <div><strong><%= _stats.livree %></strong><small>Livrées</small></div>
    </div>
    <div class="zurion-lv-stat zurion-lv-stat--annulee">
      <span class="zurion-lv-stat__icon"><i class="fa-solid fa-circle-xmark"></i></span>
      <div><strong><%= _stats.annulee %></strong><small>Annulées</small></div>
    </div>
  </div>

  <!-- Messagerie interne : écrire aux admins (réservé livreur) -->
  <% if (_isInternalMsg && currentUser.role === 'livreur') { %>
  <div class="card mb-4">
    <div class="card-header"><strong><i class="fas fa-envelope me-1"></i>Messages aux administrateurs</strong>
      <a href="/messages" class="float-end small">Ouvrir la section Messages →</a>
    </div>
    <div class="card-body">
      <div class="mb-2">
        <label class="form-label" for="liv-admin-select">Administrateur destinataire</label>
        <select id="liv-admin-select" class="form-select"><option>Chargement…</option></select>
      </div>
      <div class="mb-2">
        <textarea id="liv-msg-text" class="form-control" rows="2" maxlength="2000" placeholder="Écrivez votre message à l'admin…"></textarea>
      </div>
      <button id="liv-send-btn" class="btn btn-primary btn-sm"><i class="fas fa-paper-plane me-1"></i>Envoyer à l'admin</button>
    </div>
  </div>
  <% } %>

  <h2 class="mt-5 zurion-lv-section-title"><i class="fa-solid fa-box-open me-2"></i>Mes livraisons assignées</h2>
  <%- include('../partials/livreur-livraisons', { livraisons }) %>
</div>

<script nonce="<%= nonce %>">
// Polling du compteur de notifications
(async function pollUnread() {
  try {
    const res = await fetch('/api/notifications/unread-count', { credentials: 'include' });
    const data = await res.json();
    const el = document.getElementById('unread-count');
    if (el) el.textContent = data.unreadCount || 0;
  } catch (e) { console.error('poll error', e); }
})();
setInterval(pollUnread, 30000);

// Messagerie livreur → admin
async function loadAdminContacts() {
  try {
    const res = await fetch('/api/messages/contacts', { credentials: 'include' });
    const data = await res.json();
    const sel = document.getElementById('liv-admin-select');
    if (!sel) return;
    sel.innerHTML = '';
    (data.contacts || []).forEach(c => {
      const o = document.createElement('option');
      o.value = c.id;
      o.textContent = `${c.firstName} ${c.lastName} — ${c.email}`;
      sel.appendChild(o);
    });
    if (!data.contacts || !data.contacts.length) sel.innerHTML = '<option>Aucun admin disponible</option>';
  } catch (e) { console.error('contacts error', e); }
}
async function sendLivMsg() {
  const sel = document.getElementById('liv-admin-select');
  const txt = document.getElementById('liv-msg-text');
  const recipientId = sel ? Number(sel.value) : NaN;
  const message = txt ? txt.value.trim() : '';
  if (!recipientId || !message) { alert('Choisissez un admin et écrivez un message.'); return; }
  const res = await fetch('/api/messages', {
    method: 'POST', credentials: 'include',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.ZURION.csrfToken },
    body: JSON.stringify({ recipientId, message })
  });
  const d = await res.json().catch(() => ({}));
  if (res.ok) { alert('✅ Message envoyé à l\'admin.'); txt.value = ''; }
  else alert('❌ ' + (d.error || 'Erreur'));
}
loadAdminContacts();
document.getElementById('liv-send-btn')?.addEventListener('click', sendLivMsg);
</script>