<% const isActive = (p) => p === currentPath; %>
<% const pinnedSlugs = ['montres-connectees', 'eclairage', 'audio']; %>
<% const pinnedCategories = pinnedSlugs.map(slug => (categories || []).find(c => c.slug === slug)).filter(Boolean); %>
<% const dropdownCategories = (categories || []).filter(c => !pinnedSlugs.includes(c.slug)); %>
<%
  const userRole = (typeof currentUser !== 'undefined' && currentUser) ? currentUser.role : null;
  const defaultBackForRole = userRole === 'livreur' ? '/livreur'
    : userRole === 'superadmin' ? '/admin?tab=overview'
    : userRole === 'admin' ? ((typeof currentPath !== 'undefined' && currentPath && currentPath.startsWith('/admin/produits')) ? '/admin?tab=products' : '/admin?tab=livraisons')
    : '/';
  const resolvedBackHref = (typeof backHref !== 'undefined' && backHref !== '/' && backHref !== null) ? backHref : defaultBackForRole;
  const showBackButton = userRole === 'livreur' || userRole === 'admin' || userRole === 'superadmin';
%>
<header class="zurion-header">
  <div class="container zurion-header__row">
    <% if (showBackButton) { %>
      <a href="<%= resolvedBackHref %>" class="zurion-back-btn" aria-label="Retour" title="Retour">
        <i class="fa-solid fa-chevron-left"></i>
      </a>
    <% } %>
    <a href="/" class="zurion-logo" aria-label="ZURION Store">
      <img src="/images/Zurion/SVG/Zurion Black.svg" alt="ZURION" width="150" height="44">
    </a>

    <button class="zurion-burger" data-zurion-burger aria-label="Menu">
      <span></span><span></span><span></span>
    </button>

    <nav class="zurion-nav" data-zurion-menu aria-label="Navigation principale">
      <ul>
        <li><a href="/" class="<%= isActive('/') ? 'is-active' : '' %>">Accueil</a></li>
        <li class="zurion-nav__item--dropdown" data-zurion-dropdown>
          <button type="button" class="zurion-nav__dropdown-toggle" aria-haspopup="true" aria-expanded="false" data-zurion-dropdown-toggle>
            Catalogue
            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
          </button>
          <ul class="zurion-dropdown" data-zurion-dropdown-menu>
            <li><a href="/catalogue" class="<%= isActive('/catalogue') ? 'is-active' : '' %>">Tout le catalogue</a></li>
            <% dropdownCategories.forEach(c => { %>
              <li><a href="/catalogue?category=<%= c.slug %>"><%- esc(c.name) %></a></li>
            <% }) %>
          </ul>
        </li>
        <% pinnedCategories.forEach(c => { %>
          <li><a href="/catalogue?category=<%= c.slug %>"><%- esc(c.name) %></a></li>
        <% }) %>
      </ul>
    </nav>

    <div class="zurion-header__actions">
      <a href="/catalogue" class="zurion-icon-btn" aria-label="Rechercher" data-zurion-search-toggle>
        <i class="fa-solid fa-magnifying-glass"></i>
      </a>
      <a href="<%= currentUser ? (currentUser.role === 'livreur' ? '/livreur' : '/compte') : '/connexion' %>" class="zurion-icon-btn" aria-label="<%= currentUser && currentUser.role === 'livreur' ? 'Espace livreur' : 'Mon compte' %>">
        <i class="fa-solid <%= currentUser && currentUser.role === 'livreur' ? 'fa-motorcycle' : 'fa-user' %>"></i>
      </a>
      <a href="/favoris" class="zurion-icon-btn" aria-label="Favoris">
        <i class="fa-regular fa-heart"></i>
        <span class="zurion-count" data-zurion-wish-count>0</span>
      </a>
      <% if (currentUser && ['superadmin', 'admin', 'livreur'].includes(currentUser.role)) { %>
        <a href="/messages" class="zurion-icon-btn" aria-label="Messages" title="Messages">
          <i class="fa-solid fa-envelope"></i>
        </a>
      <% } %>
      <% if (currentUser && currentUser.role === 'livreur') { %>
        <form method="post" action="/deconnexion" title="Se déconnecter">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="zurion-icon-btn" aria-label="Se déconnecter">
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
          </button>
        </form>
      <% } %>
            <a href="/panier" class="zurion-icon-btn" aria-label="Panier">
        <i class="fa-solid fa-cart-shopping"></i>
        <span class="zurion-count" data-zurion-cart-count><%= cartCount || 0 %></span>
      </a>
      <%- include('notification-center', { currentUser }) %>
    </div>
  </div>

  <div class="zurion-search-bar" data-zurion-search hidden>
    <div class="container">
      <form action="/catalogue" method="get" class="zurion-search-form">
        <input type="search" name="q" placeholder="Rechercher un produit…" autocomplete="off" data-zurion-search-input>
        <button type="submit" class="btn btn-primary">Rechercher</button>
      </form>
      <div class="zurion-suggestions" data-zurion-suggestions hidden></div>
    </div>
  </div>
  <style>
    .zurion-back-btn {
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      display: flex;
      align-items: center;
      padding: 0 0.75rem;
      color: var(--zurion-body);
      text-decoration: none;
      font-size: 1rem;
    }
    .zurion-header__actions form { display: inline-flex; }
    .zurion-header__actions button.zurion-icon-btn {
      border: 0;
      background: transparent;
      cursor: pointer;
      font-size: 1.7rem;
    }
    .zurion-header__actions button.zurion-icon-btn:hover {
      background: #fdf1ef;
      color: #b04332;
    }
    @media (max-width: 991px) {
      .zurion-header__row { padding-left: 2.5rem; }
    }
  </style>
</header>
