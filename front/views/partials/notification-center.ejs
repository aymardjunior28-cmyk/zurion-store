<% if (typeof currentUser !== 'undefined' && currentUser && ['superadmin', 'admin', 'livreur'].includes(currentUser.role)) { %>
  <a href="/notifications" class="zurion-icon-btn" aria-label="Notifications" title="Notifications">
    <i class="fa-solid fa-bell" aria-hidden="true"></i>
    <span id="notif-badge" class="zurion-count" style="display:none;">0</span>
  </a>

  <script nonce="<%= nonce %>">
  (function () {
    async function refreshNotifications() {
      try {
        const res = await fetch('/api/notifications/unread-count', { credentials: 'include' });
        if (!res.ok) return;
        const data = await res.json();
        const count = Number(data.unreadCount) || 0;
        const badge = document.getElementById('notif-badge');
        if (badge) {
          badge.textContent = String(count);
          badge.style.display = count > 0 ? 'inline-flex' : 'none';
        }
      } catch (_) {}
    }

    refreshNotifications();
    setInterval(refreshNotifications, 30000);
  }());
  </script>
<% } %>
