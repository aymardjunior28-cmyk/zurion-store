<div class="container">
  <div class="zurion-page-head">
    <nav class="zurion-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span>/</span><span>Panier</span>
    </nav>
    <h1>Votre panier</h1>
  </div>

  <% if (cart && cart.items && cart.items.length) { %>
    <div class="zurion-cart">
      <div class="zurion-cart__items">
        <% cart.items.forEach(line => { const p = line.product; %>
          <div class="zurion-cart-row" data-cart-row="<%= p.id %>">
            <a href="/produit/<%= p.slug %>" class="zurion-cart-row__media">
              <img src="<%= productImage(p) %>" alt="<%- esc(p.name) %>">
            </a>
            <div class="zurion-cart-row__info">
              <a href="/produit/<%= p.slug %>"><strong><%- esc(p.name) %></strong></a>
              <span class="zurion-cart-row__price"><%= money(p.price) %></span>
            </div>
            <div class="zurion-qty">
              <button type="button" data-qty-minus aria-label="Diminuer">−</button>
              <input type="number" value="<%= line.quantity %>" min="1" max="<%= Math.max(p.stock, 1) %>" inputmode="numeric" data-qty-input data-cart-qty="<%= p.id %>">
              <button type="button" data-qty-plus aria-label="Augmenter">+</button>
            </div>
            <strong class="zurion-cart-row__total"><%= money(p.price * line.quantity) %></strong>
            <button class="zurion-cart-row__remove" data-cart-remove="<%= p.id %>" aria-label="Retirer">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        <% }) %>
        <div class="zurion-cart__foot">
          <a href="/catalogue" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left-long"></i> Continuer mes achats</a>
          <form method="post" action="/panier/vider" style="display:inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-link zurion-muted" data-cart-clear>Vider le panier</button>
          </form>
        </div>
      </div>

      <aside class="zurion-cart__summary">
        <h2>Récapitulatif</h2>
        <p class="d-flex justify-content-between"><span>Sous-total</span><strong id="zurion-subtotal"><%= money(totals.subtotal) %></strong></p>
        <p class="d-flex justify-content-between"><span>Livraison</span><strong class="zurion-muted">Calculée à l’étape suivante</strong></p>
        <hr>
        <p class="d-flex justify-content-between zurion-cart__grand"><span>Total</span><strong id="zurion-grand-total"><%= money(totals.subtotal) %></strong></p>
        <a href="/commande" class="btn btn-primary btn-lg btn-block"><i class="fa-solid fa-circle-check"></i> Passer la commande</a>
        <p class="zurion-muted small text-center mt-2">Paiement sécurisé · Livraison suivie</p>
      </aside>
    </div>
  <% } else { %>
    <div class="zurion-empty">
      <i class="fa-solid fa-cart-shopping" style="font-size:4rem"></i>
      <h2>Votre panier est vide</h2>
      <p>Explorez notre sélection technologique et ajoutez vos produits préférés.</p>
      <a href="/catalogue" class="btn btn-primary">Voir le catalogue</a>
    </div>
  <% } %>
</div>
