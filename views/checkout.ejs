<div class="container">
  <div class="zurion-page-head">
    <nav class="zurion-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span>/</span><a href="/panier">Panier</a><span>/</span><span>Commande</span>
    </nav>
    <h1>Finaliser la commande</h1>
  </div>

  <div class="zurion-checkout">
    <form action="/commande" method="post" class="zurion-checkout__form" data-checkout-form>
      <div class="zurion-stepper">
        <span class="is-active">1. Livraison</span>
        <span>2. Paiement</span>
        <span>3. Confirmation</span>
      </div>

      <h2>Adresse de livraison</h2>
      <div class="zurion-form-grid">
        <label>Nom complet
          <input type="text" name="fullName" class="form-control" required value="<%= currentUser ? esc(currentUser.firstName + ' ' + currentUser.lastName) : '' %>">
        </label>
        <label>Téléphone
          <input type="tel" name="phone" class="form-control" required value="<%= currentUser && currentUser.phone ? esc(currentUser.phone) : '' %>">
        </label>
        <label class="zurion-form-grid__full">Adresse
          <input type="text" name="line1" class="form-control" required placeholder="Rue, quartier, immeuble…">
        </label>
        <label>Ville
          <input type="text" name="city" class="form-control" required placeholder="Douala">
        </label>
        <label>Région
          <input type="text" name="region" class="form-control" required placeholder="Littoral">
        </label>
      </div>

      <h2>Mode de livraison</h2>
      <% Object.entries(deliveryModes).forEach(([key, mode]) => { %>
        <label class="zurion-radio">
          <input type="radio" name="deliveryMode" value="<%= key %>" <%= key === 'standard' ? 'checked' : '' %> data-delivery="<%= mode.fee %>">
          <span>
            <strong><%= mode.label %></strong>
            <small><%= mode.days %> · <%= money(mode.fee) %></small>
          </span>
        </label>
      <% }) %>

      <h2>Paiement <span class="zurion-badge zurion-badge--info">Démonstration</span></h2>
      <% paymentMethods.forEach(m => { %>
        <label class="zurion-radio">
          <input type="radio" name="paymentMethod" value="<%= m %>" <%= m === 'Paiement à la livraison' ? 'checked' : '' %>>
          <span><strong><%= m %></strong></span>
        </label>
      <% }) %>

      <button type="submit" class="btn btn-primary btn-lg btn-block">Confirmer la commande <i class="icon-long-arrow-right"></i></button>
    </form>

    <aside class="zurion-cart__summary">
      <h2>Votre commande</h2>
      <% cart.items.forEach(line => { const p = line.product; %>
        <p class="d-flex justify-content-between">
          <span><%= esc(p.name) %> × <%= line.quantity %></span>
          <strong><%= money(p.price * line.quantity) %></strong>
        </p>
      <% }) %>
      <hr>
      <p class="d-flex justify-content-between"><span>Sous-total</span><strong><%= money(totals.subtotal) %></strong></p>
      <p class="d-flex justify-content-between"><span>Livraison</span><strong id="zurion-delivery-fee"><%= money(0) %></strong></p>
      <p class="d-flex justify-content-between zurion-cart__grand"><span>Total</span><strong id="zurion-order-total"><%= money(totals.subtotal) %></strong></p>
      <p class="zurion-muted small">Paiement simulé pour cette démonstration. Aucun débit réel ne sera effectué.</p>
    </aside>
  </div>
</div>