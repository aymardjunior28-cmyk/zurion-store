<%
  const STATUS_LABELS = {
    'créée': 'Créée',
    'paiement_confirmé': 'Paiement confirmé',
    'préparation': 'En préparation',
    'expédition': 'En expédition',
    'livraison': 'En livraison',
    'terminée': 'Terminée',
  };
  let addr = {};
  try { addr = JSON.parse(order.addressSnapshot); } catch (_) { addr = {}; }
  const deliveryLabel = deliveryModes[order.deliveryMode] ? deliveryModes[order.deliveryMode].label : order.deliveryMode;
  const subtotal = Math.max(0, order.total - order.shipping);
  const fmtDateTime = (d) => new Date(d).toLocaleString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' });
%>
<div class="container">
  <div class="zurion-confirm-hero">
    <span class="zurion-confirm-hero__icon"><i class="icon-check-circle"></i></span>
    <h1>Merci pour votre commande !</h1>
    <p>Votre commande <strong><%= esc(order.reference) %></strong> a bien été enregistrée.</p>
    <span class="zurion-status is-info"><%= STATUS_LABELS[order.status] || esc(order.status) %></span>
  </div>

  <div class="zurion-confirm">
    <section class="zurion-section-block">
      <h2>Récapitulatif</h2>
      <table class="zurion-table">
        <thead>
          <tr><th>Produit</th><th>Prix unitaire</th><th>Qté</th><th>Total</th></tr>
        </thead>
        <tbody>
          <% order.items.forEach((it) => { %>
            <tr>
              <td><%= esc(it.nameSnapshot) %></td>
              <td><%= money(it.priceSnapshot) %></td>
              <td><%= it.quantity %></td>
              <td><strong><%= money(it.priceSnapshot * it.quantity) %></strong></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr><td colspan="3">Sous-total</td><td><%= money(subtotal) %></td></tr>
          <tr><td colspan="3">Livraison — <%= esc(deliveryLabel) %></td><td><%= money(order.shipping) %></td></tr>
          <tr class="zurion-table__grand"><td colspan="3">Total payé</td><td><strong><%= money(order.total) %></strong></td></tr>
        </tfoot>
      </table>
    </section>

    <aside class="zurion-section-block">
      <h2>Livraison</h2>
      <p><strong><%= esc(addr.fullName || '—') %></strong></p>
      <p><%= esc(addr.line1 || '') %><%= addr.line2 ? ', ' + esc(addr.line2) : '' %></p>
      <p><%= esc(addr.city || '') %><%= addr.region ? ', ' + esc(addr.region) : '' %></p>
      <p class="zurion-muted"><i class="icon-phone"></i> <%= esc(addr.phone || '') %></p>
      <hr>
      <h2>Paiement</h2>
      <p><%= esc(order.paymentMethod) %></p>
      <p class="zurion-muted small">Commande passée le <%= fmtDateTime(order.createdAt) %>.</p>
    </aside>
  </div>

  <div class="zurion-confirm__actions">
    <% if (currentUser) { %>
      <a href="/compte" class="btn btn-primary">Suivre mes commandes</a>
    <% } else { %>
      <a href="/inscription" class="btn btn-primary">Créer un compte pour suivre ma commande</a>
    <% } %>
    <a href="/catalogue" class="btn btn-outline">Continuer mes achats</a>
  </div>
</div>
