<div class="container">
  <div class="zurion-page-head">
    <nav class="zurion-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span>/</span><span>Mes favoris</span>
    </nav>
    <h1>Mes favoris</h1>
    <p><%= products.length %> produit(s) sauvegardé(s)</p>
  </div>

  <% if (!products.length) { %>
    <div class="zurion-empty">
      <i class="icon-heart-o" style="font-size:4rem"></i>
      <h2>Aucun favori pour l’instant</h2>
      <p>Touchez le cœur sur un produit pour le retrouver ici.</p>
      <a href="/catalogue" class="btn btn-primary">Explorer le catalogue</a>
    </div>
  <% } else { %>
    <div class="zurion-grid zurion-grid--4">
      <% products.forEach((product) => { %>
        <%- include('partials/product-card', { product }) %>
      <% }) %>
    </div>
  <% } %>
</div>
