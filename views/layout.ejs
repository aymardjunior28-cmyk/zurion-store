<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title><%= (typeof title !== 'undefined' && title) ? title + ' · ' + appName : appName %></title>
  <meta name="description" content="ZURION Store — produits électroniques et accessoires technologiques.">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/icons/favicon-32x32.png">
  <link rel="preload" href="/fonts/molla0ab2.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/storefront.css">
  <script>window.ZURION = { cartToken: '<%= cartToken || "" %>' };</script>
</head>
<body>
  <%- include('partials/header', { currentPath, currentUser, cartCount, categories }) %>

  <main class="zurion-main">
    <%- body %>
  </main>

  <%- include('partials/footer') %>

  <!-- Toast container + scripts -->
  <div id="zurion-toasts" class="zurion-toasts" aria-live="polite"></div>
  <script src="/js/storefront.js"></script>
</body>
</html>