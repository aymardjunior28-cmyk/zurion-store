<%
  const STATUS_LABELS = {
    'créée': 'Créée',
    'paiement_confirmé': 'Paiement confirmé',
    'préparation': 'En préparation',
    'expédition': 'En expédition',
    'livraison': 'En livraison',
    'terminée': 'Terminée',
    'annulée': 'Annulée',
  };
  const STATUS_CLS = {
    'créée': 'is-info',
    'paiement_confirmé': 'is-success',
    'préparation': 'is-warning',
    'expédition': 'is-warning',
    'livraison': 'is-warning',
    'terminée': 'is-success',
    'annulée': 'is-danger',
  };
  const ANNULABLES = ['créée', 'paiement_confirmé'];
  const fmtDate = (d) => new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
  const initials = ((currentUser.firstName || 'Z')[0] + (currentUser.lastName || '')[0] || 'Z').toUpperCase();
  const totalSpent = orders.reduce((s, o) => s + (o.status !== 'annulée' ? Number(o.total) || 0 : 0), 0);
  const activeOrders = orders.filter(o => !['terminée', 'annulée'].includes(o.status)).length;
  const isAdmin = currentUser.role === 'admin';
  const historyCount = orders.filter(o => ['terminée', 'annulée'].includes(o.status)).length;
%>
<div class="container">
  <nav class="zurion-breadcrumb" aria-label="Fil d’Ariane" style="padding-top:2.4rem">
    <a href="/">Accueil</a><span>/</span><span>Mon compte</span>
  </nav>

  <div class="zurion-account">
    <aside class="zurion-account__side">
      <div class="zurion-account__card">
        <div class="zurion-account__profile">
          <div class="zurion-account__avatar"><%- esc(initials) %></div>
          <h2><%- esc(currentUser.firstName) %> <%- esc(currentUser.lastName) %></h2>
          <p><%- esc(currentUser.email) %></p>
          <span class="zurion-account__role <%= isAdmin ? 'is-admin' : '' %>"><i class="fa-solid <%= isAdmin ? 'fa-shield-halved' : 'fa-user' %>" style="margin-right:.4rem"></i><%= isAdmin ? 'Administrateur' : 'Client' %></span>
          <% if (isAdmin) { %>
            <p style="margin-top:1rem"><a href="/admin" class="btn btn-primary btn-sm" style="width:100%"><i class="fa-solid fa-gauge-high"></i> Espace admin</a></p>
          <% } %>
        </div>
        <nav class="zurion-account__nav" aria-label="Navigation compte">
          <a href="#resume" class="is-active"><i class="fa-solid fa-gauge-high"></i> Vue d'ensemble</a>
          <a href="#commandes"><i class="fa-solid fa-truck-fast"></i> Mes commandes <span class="zurion-count" style="position:static"><%= orders.length %></span></a>
          <a href="#achats"><i class="fa-solid fa-bag-shopping"></i> Produits achetés <span class="zurion-count" style="position:static"><%= purchased.length %></span></a>
          <a href="#adresses"><i class="fa-solid fa-map-location-dot"></i> Mes adresses <span class="zurion-count" style="position:static"><%= addresses.length %></span></a>
          <a href="/favoris"><i class="fa-regular fa-heart"></i> Mes favoris</a>
        </nav>
        <div class="zurion-account__logout">
          <form method="post" action="/deconnexion">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-outline btn-sm"><i class="fa-solid fa-arrow-right-from-bracket"></i> Se déconnecter</button>
          </form>
        </div>
      </div>
    </aside>

    <div class="zurion-account__main">
      <section id="resume" class="zurion-account__section">
        <h2>Bonjour, <%- esc(currentUser.firstName) %></h2>
        <p class="zurion-muted" style="margin:.2rem 0 1.8rem">Suivez ici vos commandes et vos informations.</p>
        <div class="zurion-account__stats">
          <div class="zurion-stat is-accent">
            <small>Commandes</small>
            <strong><%= orders.length %></strong>
            <i class="fa-solid fa-receipt zurion-stat__icon"></i>
          </div>
          <div class="zurion-stat <%= activeOrders ? 'is-warning' : '' %>">
            <small>En cours</small>
            <strong><%= activeOrders %></strong>
            <i class="fa-solid fa-hourglass-half zurion-stat__icon"></i>
          </div>
          <div class="zurion-stat is-success">
            <small>Produits achetés</small>
            <strong><%= purchased.length %></strong>
            <i class="fa-solid fa-bag-shopping zurion-stat__icon"></i>
          </div>
          <div class="zurion-stat">
            <small>Total dépensé</small>
            <strong style="font-size:1.9rem"><%= money(totalSpent) %></strong>
            <i class="fa-solid fa-wallet zurion-stat__icon"></i>
          </div>
        </div>
      </section>
      <section id="commandes" class="zurion-account__section">
        <div class="zurion-admin__title">
          <h2><i class="fa-solid fa-truck-fast" style="margin-right:.6rem;color:var(--zurion-primary)"></i> Mes commandes</h2>
          <span style="display:flex;align-items:center;gap:1rem">
            <span class="zurion-muted"><%= orders.length %> au total</span>
            <% if (historyCount > 0) { %>
              <form method="post" action="/compte/commandes/historique/effacer" data-confirm="Effacer définitivement votre historique (<%= historyCount %> commande(s) terminée(s) ou annulée(s)) ? Les commandes en cours sont conservées.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-sm zurion-btn-danger"><i class="fa-solid fa-trash-can"></i> Effacer l'historique</button>
              </form>
            <% } %>
          </span>
        </div>
        <% if (!orders.length) { %>
          <div class="zurion-empty">
            <i class="fa-solid fa-truck" style="font-size:4rem"></i>
            <h3>Aucune commande pour le moment</h3>
            <p>Vos futures commandes apparaîtront ici avec leur suivi en temps réel.</p>
            <a href="/catalogue" class="btn btn-primary">Découvrir le catalogue</a>
          </div>
        <% } else { %>
          <% orders.forEach((order) => { const idx = orderStatuses.indexOf(order.status); const step = idx < 0 ? 0 : idx + 1; %>
            <article class="zurion-account__order">
              <div class="zurion-account__order-head">
                <div>
                  <strong class="zurion-order__ref"><%- esc(order.reference) %></strong>
                  <span class="zurion-muted"> · <%= fmtDate(order.createdAt) %></span>
                </div>
                <span class="zurion-status <%= STATUS_CLS[order.status] || 'is-info' %>"><%= STATUS_LABELS[order.status] || esc(order.status) %></span>
              </div>
              <ol class="zurion-steps">
                <% orderStatuses.forEach((s, i) => { %>
                  <li class="<%= i < step ? 'is-done' : (i === step - 1 ? 'is-current' : '') %>"><%= STATUS_LABELS[s] %></li>
                <% }) %>
              </ol>
              <ul class="zurion-account__order-list">
                <% order.items.forEach((it) => { %>
                  <li><%- esc(it.nameSnapshot) %> <span class="zurion-muted">× <%= it.quantity %></span></li>
                <% }) %>
              </ul>
              <div class="zurion-account__order-foot">
                <strong>Total : <%= money(order.total) %><% if (order.discount > 0) { %> <span class="zurion-muted" style="font-weight:500;font-size:1.2rem">(dont <%- esc(order.couponCode) %> : -<%= money(order.discount) %>)</span><% } %></strong>
                <span style="display:flex;gap:.8rem;flex-wrap:wrap">
                  <a href="/commande/confirmation/<%= encodeURIComponent(order.reference) %>" class="btn btn-outline btn-sm">Voir le détail</a>
                  <% if (ANNULABLES.includes(order.status)) { %>
                    <form method="post" action="/compte/commandes/<%= encodeURIComponent(order.reference) %>/annuler" data-confirm="Annuler la commande <%- esc(order.reference) %> ?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-sm zurion-btn-danger">Annuler</button>
                    </form>
                  <% } %>
                </span>
              </div>
            </article>
          <% }) %>
        <% } %>
      </section>
      <% if (purchased && purchased.length) { %>
      <section id="achats" class="zurion-account__section">
        <div class="zurion-admin__title">
          <h2><i class="fa-solid fa-bag-shopping" style="margin-right:.6rem;color:var(--zurion-success)"></i> Mes produits achetés</h2>
          <span class="zurion-muted"><%= purchased.length %> au total</span>
        </div>
        <div class="zurion-grid zurion-grid--4">
          <% purchased.forEach(p => { %>
            <article class="zurion-product-card">
              <a href="/produit/<%= p.slug %>" class="zurion-product-card__media">
                <img src="<%= productImage(p) %>" alt="<%- esc(p.name) %>" loading="lazy">
              </a>
              <div class="zurion-product-card__body">
                <h3><a href="/produit/<%= p.slug %>"><%- esc(p.name) %></a></h3>
                <p class="zurion-product-card__price"><strong><%= money(p.price) %></strong></p>
                <p class="zurion-product-card__stock is-success"><i class="fa-solid fa-check"></i> <%= p.quantity %> acheté(s)</p>
              </div>
            </article>
          <% }) %>
        </div>
      </section>
      <% } %>

      <section id="adresses" class="zurion-account__section">
        <div class="zurion-admin__title">
          <h2><i class="fa-solid fa-map-location-dot" style="margin-right:.6rem;color:var(--zurion-primary)"></i> Mes adresses</h2>
          <span class="zurion-muted"><%= addresses.length %> enregistrée(s)</span>
        </div>
        <% if (addresses.length) { %>
          <ul class="zurion-account__order-list" style="margin-bottom:1.6rem">
            <% addresses.forEach(address => { %>
              <li style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap">
                <span><strong><%- esc(address.label) %><%= address.isDefault ? ' · Par défaut' : '' %></strong><br>
                <span class="zurion-muted"><%- esc(`${address.fullName} · ${address.line1}, ${address.city}, ${address.region}`) %></span></span>
                <form method="post" action="/compte/adresses/<%= address.id %>/supprimer">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-outline btn-sm" type="submit">Supprimer</button>
                </form>
              </li>
            <% }) %>
          </ul>
        <% } %>
        <form method="post" action="/compte/adresses" class="zurion-form-grid">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Libellé<input class="form-control" name="label" maxlength="60" placeholder="Domicile"></label>
          <label>Destinataire<input class="form-control" name="fullName" required maxlength="120"></label>
          <label>Téléphone<input class="form-control" name="phone" required maxlength="30"></label>
          <label>Adresse<input class="form-control" name="line1" required maxlength="180"></label>
          <label class="zurion-form-grid__full">Complément<input class="form-control" name="line2" maxlength="180"></label>
          <label>Ville<input class="form-control" name="city" required maxlength="80"></label>
          <label>Région<input class="form-control" name="region" required maxlength="80"></label>
          <label class="zurion-check zurion-form-grid__full"><input type="checkbox" name="isDefault"> Définir comme adresse par défaut</label>
          <div class="zurion-form-grid__full"><button type="submit" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Ajouter l'adresse</button></div>
        </form>
      </section>
      <div class="zurion-account__secgrid">
        <section id="profil" class="zurion-account__section">
          <div class="zurion-admin__title">
            <h2><i class="fa-solid fa-user-pen" style="margin-right:.6rem;color:var(--zurion-primary)"></i> Mon profil</h2>
          </div>
          <form method="post" action="/compte/profil" class="zurion-form-grid">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label>Prénom<input class="form-control" name="firstName" required minlength="2" maxlength="80" value="<%- esc(currentUser.firstName) %>"></label>
            <label>Nom<input class="form-control" name="lastName" required minlength="2" maxlength="80" value="<%- esc(currentUser.lastName) %>"></label>
            <label class="zurion-form-grid__full">Téléphone<input class="form-control" name="phone" maxlength="30" value="<%- esc(currentUser.phone || '') %>"></label>
            <div class="zurion-form-grid__full"><button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Enregistrer</button></div>
          </form>
        </section>

        <section id="securite" class="zurion-account__section">
          <div class="zurion-admin__title">
            <h2><i class="fa-solid fa-shield-halved" style="margin-right:.6rem;color:var(--zurion-primary)"></i> Sécurité</h2>
          </div>
          <form method="post" action="/compte/mot-de-passe" class="zurion-form-grid">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="zurion-form-grid__full">Mot de passe actuel<input class="form-control" type="password" name="currentPassword" required autocomplete="current-password" maxlength="72"></label>
            <label class="zurion-form-grid__full">Nouveau mot de passe<input class="form-control" type="password" name="newPassword" required minlength="8" autocomplete="new-password" placeholder="8 caractères minimum" maxlength="72"></label>
            <label class="zurion-form-grid__full">Confirmer le nouveau mot de passe<input class="form-control" type="password" name="confirmPassword" required minlength="8" autocomplete="new-password" maxlength="72"></label>
            <div class="zurion-form-grid__full"><button type="submit" class="btn btn-primary"><i class="fa-solid fa-key"></i> Mettre à jour</button></div>
          </form>
        </section>
      </div>
    </div>
  </div>
</div>