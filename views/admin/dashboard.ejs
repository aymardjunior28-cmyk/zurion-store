<%
  const statusLabels = { 'créée': 'Créée', 'paiement_confirmé': 'Paiement confirmé', 'préparation': 'Préparation', 'expédition': 'Expédition', 'livraison': 'Livraison', 'terminée': 'Terminée', 'annulée': 'Annulée' };
  const statusClass = { 'créée': 'zurion-badge-warning', 'paiement_confirmé': 'zurion-badge-info', 'préparation': 'zurion-badge-info', 'expédition': 'zurion-badge-info', 'livraison': 'zurion-badge-success', 'terminée': 'zurion-badge-success', 'annulée': 'zurion-badge-danger' };
  const livStatusLabels = { 'en_cours': 'En cours', 'livrée': 'Livrée', 'annulée': 'Annulée' };
  const livStatusClass = { 'en_cours': 'zurion-badge-info', 'livrée': 'zurion-badge-success', 'annulée': 'zurion-badge-danger' };
  const fmtDate = (d) => new Date(d).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
  const fmtMoney = (n) => Number(n || 0).toLocaleString('fr-FR') + ' FCFA';
  const tab = activeTab || 'overview';
%>
<div class="zurion-admin__layout">
  <%- include('../partials/admin/nav') %>
  <main class="zurion-admin__main">
    <header class="zurion-admin__head">
      <div>
        <h1>Administration</h1>
        <p>Gérez l'ensemble de votre boutique ZURION depuis cet espace.</p>
      </div>
      <span class="zurion-admin__date"><i class="fa-regular fa-calendar"></i> <%= new Date().toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></span>
    </header>

    <% if (error) { %><div class="zurion-form-error"><%- esc(error) %></div><% } %>
        <% if (okSaved) { %><div class="zurion-form-success">Modifications enregistrées.</div><% } %>

    <nav class="zurion-admin__tabs" aria-label="Sections administration">
      <a href="/admin?tab=overview" class="<%= tab === 'overview' ? 'is-active' : '' %>"><i class="fa-solid fa-gauge-high"></i> Vue d'ensemble</a>
      <a href="/admin?tab=products" class="<%= tab === 'products' ? 'is-active' : '' %>"><i class="fa-solid fa-box"></i> Marchandise</a>
      <a href="/admin?tab=orders" class="<%= tab === 'orders' ? 'is-active' : '' %>"><i class="fa-solid fa-truck-fast"></i> Commandes</a>
      <a href="/admin?tab=livraisons" class="<%= tab === 'livraisons' ? 'is-active' : '' %>"><i class="fa-solid fa-truck-ramp-box"></i> Livraisons</a>
      <a href="/admin?tab=couriers" class="<%= tab === 'couriers' ? 'is-active' : '' %>"><i class="fa-solid fa-user-tie"></i> Livreurs</a>
      <a href="/admin?tab=coupons" class="<%= tab === 'coupons' ? 'is-active' : '' %>"><i class="fa-solid fa-tags"></i> Codes promo</a>
      <a href="/admin?tab=categories" class="<%= tab === 'categories' ? 'is-active' : '' %>"><i class="fa-regular fa-folder-open"></i> Catégories</a>
      <a href="/admin?tab=users" class="<%= tab === 'users' ? 'is-active' : '' %>"><i class="fa-solid fa-users"></i> Utilisateurs</a>
    </nav>

    <!-- ==================== VUE D'ENSEMBLE ==================== -->
    <section class="zurion-admin__tab-panel <%= tab === 'overview' ? 'is-active' : '' %>" data-tab="overview">
      <div class="zurion-stats">
        <div class="zurion-stat is-accent">
          <small>Chiffre d'affaires</small>
          <strong><%= money(stats.revenue) %></strong>
          <i class="fa-solid fa-sack-dollar zurion-stat__icon"></i>
        </div>
        <div class="zurion-stat is-success">
          <small>Commandes</small>
          <strong><%= stats.orderCount %></strong>
          <i class="fa-solid fa-receipt zurion-stat__icon"></i>
        </div>
        <div class="zurion-stat">
          <small>Produits actifs</small>
          <strong><%= stats.productCount %></strong>
          <i class="fa-solid fa-box-open zurion-stat__icon"></i>
        </div>
        <div class="zurion-stat <%= stats.lowStockCount ? 'is-warning' : '' %>">
          <small>Stocks faibles</small>
          <strong class="<%= stats.lowStockCount ? 'zurion-text-danger' : '' %>"><%= stats.lowStockCount %></strong>
          <i class="fa-solid fa-triangle-exclamation zurion-stat__icon"></i>
        </div>
      </div>

      <div class="zurion-stats zurion-stats--3">
        <div class="zurion-stat">
          <small>CA du mois</small>
          <strong><%= money(stats.revenueMonth) %></strong>
          <i class="fa-solid fa-calendar-day zurion-stat__icon"></i>
        </div>
        <div class="zurion-stat">
          <small>CA de la semaine</small>
          <strong><%= money(stats.revenueWeek) %></strong>
          <i class="fa-solid fa-calendar-week zurion-stat__icon"></i>
        </div>
        <div class="zurion-stat">
          <small>Panier moyen</small>
          <strong><%= money(stats.avgBasket) %></strong>
          <i class="fa-solid fa-cart-shopping zurion-stat__icon"></i>
        </div>
      </div>

      <div class="zurion-stats zurion-stats--3">
        <div class="zurion-stat">
          <small>Commandes ce mois</small>
          <strong><%= stats.orderCountMonth %></strong>
          <i class="fa-solid fa-file-invoice zurion-stat__icon"></i>
        </div>
        <div class="zurion-stat">
          <small>Livraisons en cours</small>
          <strong><%= stats.activeDeliveries %></strong>
          <i class="fa-solid fa-truck zurion-stat__icon"></i>
        </div>
        <div class="zurion-stat">
          <small>Livraisons terminées</small>
          <strong><%= stats.deliveredCount %></strong>
          <i class="fa-solid fa-circle-check zurion-stat__icon"></i>
        </div>
      </div>

      <!-- Répartition des commandes par statut -->
      <% if (ordersByStatus && ordersByStatus.length) { %>
        <div class="zurion-section-block">
          <div class="zurion-admin__title">
            <h2><i class="fa-solid fa-chart-pie" style="margin-right:.6rem;color:var(--zurion-primary)"></i> Répartition des commandes</h2>
          </div>
          <div class="zurion-stats zurion-stats--3">
            <% ordersByStatus.forEach(s => { %>
              <div class="zurion-stat">
                <small><%- esc(statusLabels[s.status] || s.status) %></small>
                <strong><%= s.count %></strong>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- Top produits vendus -->
      <% if (topProducts && topProducts.length) { %>
        <div class="zurion-section-block">
          <div class="zurion-admin__title">
            <h2><i class="fa-solid fa-trophy" style="margin-right:.6rem;color:var(--zurion-warning)"></i> Top produits vendus</h2>
          </div>
          <table class="zurion-table">
            <thead><tr><th>Produit</th><th>Unités vendues</th><th>Revenu généré</th></tr></thead>
            <tbody>
              <% topProducts.forEach(p => { %>
                <tr>
                  <td><strong><%- esc(p.nameSnapshot) %></strong></td>
                  <td><span class="zurion-badge zurion-badge-info"><%= p.totalSold %> unité(s)</span></td>
                  <td><strong><%= money(p.totalRevenue) %></strong></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>

      <div class="zurion-section-block">
        <div class="zurion-admin__title">
          <h2><i class="fa-solid fa-clock-rotate-left" style="margin-right:.6rem;color:var(--zurion-primary)"></i> Commandes récentes</h2>
          <a href="/admin?tab=orders">Tout voir <i class="fa-solid fa-arrow-right-long"></i></a>
        </div>
        <% if (recentOrders.length) { %>
          <table class="zurion-table">
            <thead><tr><th>Référence</th><th>Date</th><th>Total</th><th>Statut</th></tr></thead>
            <tbody>
              <% recentOrders.slice(0, 5).forEach(o => { %>
                <tr>
                  <td><strong><%- esc(o.reference) %></strong></td>
                  <td><%= fmtDate(o.createdAt) %></td>
                  <td><strong><%= money(o.total) %></strong></td>
                  <td><span class="zurion-badge <%= statusClass[o.status] || 'zurion-badge-info' %>"><%- esc(statusLabels[o.status] || o.status) %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %><p class="zurion-muted">Aucune commande pour le moment.</p><% } %>
      </div>

      <div class="zurion-section-block">
        <div class="zurion-admin__title">
          <h2><i class="fa-solid fa-boxes-stacked" style="margin-right:.6rem;color:var(--zurion-warning)"></i> Stocks à réapprovisionner</h2>
          <a href="/admin?tab=products">Tous les produits <i class="fa-solid fa-arrow-right-long"></i></a>
        </div>
        <% if (lowStockProducts.length) { %>
          <table class="zurion-table">
            <thead><tr><th>Produit</th><th>Prix</th><th>Stock</th></tr></thead>
            <tbody>
              <% lowStockProducts.forEach(p => { %>
                <tr>
                  <td><strong><%- esc(p.name) %></strong></td>
                  <td><%= money(p.price) %></td>
                  <td><span class="zurion-badge zurion-badge-warning"><%= p.stock %> restant(s)</span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %><p class="zurion-muted">Tous les stocks sont corrects.</p><% } %>
      </div>
    </section>

    <!-- ==================== MARCHANDISE (PRODUITS) ==================== -->
    <section class="zurion-admin__tab-panel <%= tab === 'products' ? 'is-active' : '' %>" data-tab="products">
      <div class="zurion-section-block">
        <div class="zurion-admin__title">
          <h2><i class="fa-solid fa-plus" style="margin-right:.6rem;color:var(--zurion-primary)"></i> Ajouter un produit</h2>
        </div>
        <form method="post" action="/admin/produits" enctype="multipart/form-data" class="zurion-admin-create">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="zurion-form-grid">
            <label>Nom du produit<input type="text" name="name" class="form-control" required placeholder="Ex : Écouteurs ZURION Air Pro"></label>
            <label>Catégorie<select name="categoryId" class="form-control"><option value="">— Choisir —</option><% categories.forEach(c => { %><option value="<%= c.id %>"><%- esc(c.name) %></option><% }) %></select></label>
            <label>Prix (FCFA)<input type="number" name="price" class="form-control" min="0" step="1" required placeholder="15000"></label>
            <label>Ancien prix — promo<input type="number" name="oldPrice" class="form-control" min="0" step="1" placeholder="20000"></label>
            <label>Stock<input type="number" name="stock" class="form-control" min="0" step="1" required placeholder="25"></label>
            <label>Image — fichier<input type="file" name="imageFile" class="form-control" accept="image/png,image/jpeg,image/webp,image/gif"></label>
            <label class="zurion-form-grid__full">Ou image par URL<input type="text" name="imageUrl" class="form-control" placeholder="/images/demos/demo-3/products/product-3.jpg"></label>
            <label class="zurion-form-grid__full">Description<textarea name="description" class="form-control" rows="2" placeholder="Points clés du produit…"></textarea></label>
          </div>
          <div class="zurion-check-row">
            <label class="zurion-check"><input type="checkbox" name="featured"> Produit mis en avant (accueil)</label>
            <label class="zurion-check"><input type="checkbox" name="active" checked> Produit actif (visible en boutique)</label>
          </div>
          <button type="submit" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Créer le produit</button>
        </form>
      </div>

      <div class="zurion-section-block">
        <div class="zurion-admin__title">
          <h2><i class="fa-solid fa-boxes-stacked" style="margin-right:.6rem;color:var(--zurion-primary)"></i> Tous les produits</h2>
          <span class="zurion-muted"><%= products.length %> au catalogue</span>
        </div>
        <% if (products.length) { %>
          <table class="zurion-table">
            <thead><tr><th>#</th><th>Produit</th><th>Prix</th><th>Stock</th><th>En avant</th><th>Actif</th><th>Actions</th></tr></thead>
            <tbody>
              <% products.forEach(p => { %>
                <tr>
                  <td><%= p.id %></td>
                  <td><strong><%- esc(p.name) %></strong><br><small class="zurion-muted"><%- esc(p.slug) %></small></td>
                  <td><strong><%= money(p.price) %></strong><% if (p.oldPrice && p.oldPrice > p.price) { %><br><small class="zurion-muted" style="text-decoration:line-through"><%= money(p.oldPrice) %></small><% } %></td>
                  <td><span class="zurion-badge <%= p.stock <= 0 ? 'zurion-badge-danger' : (p.stock < 5 ? 'zurion-badge-warning' : 'zurion-badge-success') %>"><%= p.stock <= 0 ? 'Rupture' : p.stock + ' unité(s)' %></span></td>
                  <td><%= p.featured ? '★' : '—' %></td>
                  <td><span class="zurion-badge <%= p.active ? 'zurion-badge-success' : 'zurion-badge-danger' %>"><%= p.active ? 'Oui' : 'Non' %></span></td>
                  <td>
                    <div class="zurion-admin-actions">
                      <a class="btn btn-outline btn-sm" href="/admin/produits/<%= p.id %>">Modifier</a>
                      <form method="post" action="/admin/produits/<%= p.id %>/supprimer" data-confirm="Supprimer définitivement « <%- esc(p.name) %> » ?">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-sm zurion-btn-danger">Supprimer</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %><p class="zurion-muted">Aucun produit. Créez-en un avec le formulaire ci-dessus.</p><% } %>
      </div>
    </section>

    <!-- ==================== COMMANDES ==================== -->
    <section class="zurion-admin__tab-panel <%= tab === 'orders' ? 'is-active' : '' %>" data-tab="orders">
      <div class="zurion-section-block">
        <div class="zurion-admin__title">
          <h2><i class="fa-solid fa-truck-fast" style="margin-right:.6rem;color:var(--zurion-primary)"></i> Suivi des commandes</h2>
          <form method="post" action="/admin/commandes/historique/effacer" data-confirm="Effacer définitivement l'historique des commandes terminées ou annulées (tous clients) ? Les commandes actives ne sont pas touchées.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-sm zurion-btn-danger"><i class="fa-solid fa-trash-can"></i> Effacer l'historique</button>
          </form>
        </div>
        <% if (recentOrders.length) { %>
          <table class="zurion-table">
            <thead><tr><th>Référence</th><th>Date</th><th>Articles</th><th>Total</th><th>Statut</th><th>Actions</th></tr></thead>
            <tbody>
              <% recentOrders.forEach(o => { %>
                <tr>
                  <td><strong><%- esc(o.reference) %></strong></td>
                  <td><%= fmtDate(o.createdAt) %></td>
                  <td><%= o.items ? o.items.length : 0 %> article(s)</td>
                  <td><strong><%= money(o.total) %></strong></td>
                  <td><span class="zurion-badge <%= statusClass[o.status] || 'zurion-badge-info' %>"><%- esc(statusLabels[o.status] || o.status) %></span></td>
                  <td>
                    <div class="zurion-admin-actions">
                      <% const idx = ['créée','paiement_confirmé','préparation','expédition','livraison','terminée'].indexOf(o.status); %>
                      <% if (idx >= 0 && idx < 5) { %>
                        <form method="post" action="/admin/commandes/<%= encodeURIComponent(o.reference) %>/statut">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn btn-primary btn-sm">→ <%- esc(statusLabels[['créée','paiement_confirmé','préparation','expédition','livraison','terminée'][idx+1]]) %></button>
                        </form>
                      <% } %>
                      <% if (['créée','paiement_confirmé'].includes(o.status)) { %>
                        <form method="post" action="/admin/commandes/<%= encodeURIComponent(o.reference) %>/annuler" data-confirm="Annuler la commande <%- esc(o.reference) %> ?">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn btn-sm zurion-btn-danger">Annuler</button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %><p class="zurion-muted">Aucune commande enregistrée pour le moment.</p><% } %>
      </div>
    </section>

    <!-- ==================== LIVRAISONS ==================== -->
    <section class="zurion-admin__tab-panel <%= tab === 'livraisons' ? 'is-active' : '' %>" data-tab="livraisons">
      <div class="zurion-section-block">
        <div class="zurion-admin__title">
          <h2><i class="fa-solid fa-truck-ramp-box" style="margin-right:.6rem;color:var(--zurion-primary)"></i> Suivi des livraisons</h2>
          <span class="zurion-muted"><%= livraisons.length %> livraison(s) au total</span>
        </div>
        <% if (livraisons.length) { %>
          <table class="zurion-table">
            <thead>
              <tr><th>Référence</th><th>Commande</th><th>Livreur</th><th>Colis</th><th>Frais</th><th>Expédiée le</th><th>Statut</th><th>Action</th></tr>
            </thead>
            <tbody>
              <% livraisons.forEach(l => { %>
                <tr>
                  <td><strong><%- esc(l.reference) %></strong></td>
                  <td><%- esc((l.order && l.order.reference) || '—') %></td>
                  <td><strong><%- esc(l.courierName) %></strong></td>
                  <td><%= l.quantity %> colis</td>
                  <td><%= money(l.price) %></td>
                  <td><%= l.shippedAt ? new Date(l.shippedAt).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : '—' %></td>
                  <td><span class="zurion-badge <%= livStatusClass[l.status] || 'zurion-badge-warning' %>"><%= livStatusLabels[l.status] || esc(l.status) %></span></td>
                  <td>
                    <% if (l.status === 'en_cours') { %>
                      <form method="post" action="/admin/livraisons/<%= l.id %>/annuler" data-confirm="Annuler la livraison « <%- esc(l.reference) %> » du livreur <%- esc(l.courierName) %> ?">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn-sm zurion-btn-danger" type="submit">Annuler</button>
                      </form>
                    <% } else { %>
                      <span class="zurion-muted">—</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <p class="zurion-muted">Aucune livraison pour le moment. Elles sont créées automatiquement dès qu'une commande passe au statut « Expédition ».</p>
        <% } %>
      </div>
    </section>

    <!-- ==================== LIVREURS ==================== -->
    <section class="zurion-admin__tab-panel <%= tab === 'couriers' ? 'is-active' : '' %>" data-tab="couriers">
      <div class="zurion-section-block">
        <div class="zurion-admin__title">
          <h2><i class="fa-solid fa-plus" style="margin-right:.6rem;color:var(--zurion-primary)"></i> Ajouter un livreur</h2>
        </div>
        <form method="post" action="/admin/livreurs" class="zurion-form-grid">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Nom du livreur<input class="form-control" name="name" required minlength="2" maxlength="80" placeholder="Ex : Daré Express"></label>
          <label>Téléphone (optionnel)<input class="form-control" name="phone" maxlength="30" placeholder="Ex : +225 07 00 00 00 00"></label>
          <div class="zurion-form-grid__full"><button type="submit" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Ajouter le livreur</button></div>
        </form>
      </div>

      <div class="zurion-section-block">
        <div class="zurion-admin__title">
          <h2><i class="fa-solid fa-user-tie" style="margin-right:.6rem;color:var(--zurion-primary)"></i> Livreurs partenaires</h2>
          <span class="zurion-muted"><%= couriers.length %> au total</span>
        </div>
        <% if (couriers.length) { %>
          <table class="zurion-table">
            <thead><tr><th>Nom</th><th>Téléphone</th><th>Actif</th><th>Actions</th></tr></thead>
            <tbody>
              <% couriers.forEach(c => { %>
                <tr>
                  <form method="post" action="/admin/livreurs/<%= c.id %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <td><input class="zurion-input-inline" style="width:14rem" name="name" value="<%- esc(c.name) %>" required minlength="2" maxlength="80"></td>
                    <td><input class="zurion-input-inline" name="phone" value="<%- esc(c.phone || '') %>" maxlength="30" placeholder="—"></td>
                    <td><input type="checkbox" name="active" <%= c.active ? 'checked' : '' %>></td>
                    <td><div class="zurion-admin-actions"><button class="btn btn-primary btn-sm" type="submit">Enregistrer</button></div></td>
                  </form>
                  <td>
                    <form method="post" action="/admin/livreurs/<%= c.id %>/supprimer" data-confirm="Supprimer le livreur « <%- esc(c.name) %> » ? Les livraisons passées conserveront son nom.">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm zurion-btn-danger" type="submit">Supprimer</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %><p class="zurion-muted">Aucun livreur. Ajoutez-en un avec le formulaire ci-dessus.</p><% } %>
      </div>
    </section>

    <!-- ==================== CODES PROMO ==================== -->
    <section class="zurion-admin__tab-panel <%= tab === 'coupons' ? 'is-active' : '' %>" data-tab="coupons">
      <div class="zurion-section-block">
        <div class="zurion-admin__title">
          <h2><i class="fa-solid fa-plus" style="margin-right:.6rem;color:var(--zurion-primary)"></i> Créer un code promo</h2>
        </div>
        <form method="post" action="/admin/codes-promo" class="zurion-form-grid">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Code<input class="form-control" name="code" required minlength="2" maxlength="40" placeholder="EX : BIENVENUE10"></label>
          <label>Type<select class="form-control" name="type"><option value="percent">Pourcentage (%)</option><option value="fixed">Montant fixe (FCFA)</option></select></label>
          <label>Valeur<input class="form-control" name="value" type="number" min="1" step="1" required placeholder="10 ou 5000"></label>
          <label>Panier minimum (FCFA)<input class="form-control" name="minAmount" type="number" min="0" step="1" placeholder="—"></label>
          <label>Utilisations max<input class="form-control" name="maxUses" type="number" min="1" step="1" placeholder="—"></label>
          <label>Début de validité<input class="form-control" name="validFrom" type="date"></label>
          <label>Fin de validité<input class="form-control" name="validUntil" type="date"></label>
          <div class="zurion-check-row zurion-form-grid__full"><label class="zurion-check"><input type="checkbox" name="active" checked> Actif immédiatement</label></div>
          <div class="zurion-form-grid__full"><button class="btn btn-primary" type="submit"><i class="fa-solid fa-plus"></i> Créer le code</button></div>
        </form>
      </div>

      <div class="zurion-section-block">
        <div class="zurion-admin__title">
          <h2><i class="fa-solid fa-tags" style="margin-right:.6rem;color:var(--zurion-primary)"></i> Codes promo</h2>
          <span class="zurion-muted"><%= coupons.length %> au total</span>
        </div>
        <% if (coupons.length) { %>
          <table class="zurion-table">
            <thead><tr><th>Code</th><th>Remise</th><th>Panier min.</th><th>Utilisations</th><th>Validité</th><th>État</th><th>Actions</th></tr></thead>
            <tbody>
              <% coupons.forEach(c => { %>
                <tr>
                  <td><strong><%- esc(c.code) %></strong></td>
                  <td><%= c.type === 'percent' ? c.value + '%' : money(c.value) %></td>
                  <td><%= c.minAmount ? money(c.minAmount) : '—' %></td>
                  <td><%= c.maxUses ? c.usedCount + ' / ' + c.maxUses : c.usedCount + ' (illimité)' %></td>
                  <td><% if (c.validFrom || c.validUntil) { %><small class="zurion-muted"><%= c.validFrom ? new Date(c.validFrom).toLocaleDateString('fr-FR') : '…' %> → <%= c.validUntil ? new Date(c.validUntil).toLocaleDateString('fr-FR') : '∞' %></small><% } else { %>—<% } %></td>
                  <td><span class="zurion-badge <%= c.active ? 'zurion-badge-success' : 'zurion-badge-danger' %>"><%= c.active ? 'Actif' : 'Inactif' %></span></td>
                  <td>
                    <div class="zurion-admin-actions">
                      <form method="post" action="/admin/codes-promo/<%= c.id %>/toggle" style="display:inline">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn-outline btn-sm" type="submit"><%= c.active ? 'Désactiver' : 'Activer' %></button>
                      </form>
                      <form method="post" action="/admin/codes-promo/<%= c.id %>/supprimer" data-confirm="Supprimer le code « <%- esc(c.code) %> » ?" style="display:inline">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn-sm zurion-btn-danger" type="submit">Supprimer</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %><p class="zurion-muted">Aucun code promo pour le moment.</p><% } %>
      </div>
    </section>

    <!-- ==================== CATÉGORIES ==================== -->
    <section class="zurion-admin__tab-panel <%= tab === 'categories' ? 'is-active' : '' %>" data-tab="categories">
      <div class="zurion-section-block">
        <div class="zurion-admin__title">
          <h2><i class="fa-solid fa-plus" style="margin-right:.6rem;color:var(--zurion-primary)"></i> Ajouter une catégorie</h2>
        </div>
        <form method="post" action="/admin/categories" class="zurion-form-grid">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Nom<input class="form-control" name="name" required minlength="2" maxlength="120"></label>
          <label>Ordre<input class="form-control" name="sortOrder" type="number" min="0" value="0"></label>
          <label class="zurion-check"><input type="checkbox" name="active" checked> Visible dans la boutique</label>
          <label class="zurion-form-grid__full">Description<textarea class="form-control" name="description" rows="2"></textarea></label>
          <div class="zurion-form-grid__full"><button class="btn btn-primary" type="submit"><i class="fa-solid fa-plus"></i> Créer la catégorie</button></div>
        </form>
      </div>

      <div class="zurion-section-block">
        <div class="zurion-admin__title">
          <h2><i class="fa-regular fa-folder-open" style="margin-right:.6rem;color:var(--zurion-primary)"></i> Catégories</h2>
          <span class="zurion-muted"><%= categories.length %> au total</span>
        </div>
        <% if (categories.length) { %>
          <table class="zurion-table">
            <thead><tr><th>Nom</th><th>Slug</th><th>Ordre</th><th>Visible</th><th>Actions</th></tr></thead>
            <tbody>
              <% categories.forEach(category => { %>
                <tr>
                  <form method="post" action="/admin/categories/<%= category.id %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <td><input class="zurion-input-inline" name="name" value="<%- esc(category.name) %>" required></td>
                    <td><%- esc(category.slug) %></td>
                    <td><input class="zurion-input-inline" type="number" name="sortOrder" min="0" value="<%= category.sortOrder %>"></td>
                    <td><input type="checkbox" name="active" <%= category.active ? 'checked' : '' %>></td>
                    <td><button class="btn btn-primary btn-sm">Enregistrer</button></td>
                  </form>
                  <td>
                    <form method="post" action="/admin/categories/<%= category.id %>/supprimer" data-confirm="Supprimer la catégorie « <%- esc(category.name) %> » ? Les produits rattachés deviendront sans catégorie.">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm zurion-btn-danger" type="submit">Supprimer</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %><p class="zurion-muted">Aucune catégorie.</p><% } %>
      </div>
    </section>

    <!-- ==================== UTILISATEURS ==================== -->
    <section class="zurion-admin__tab-panel <%= tab === 'users' ? 'is-active' : '' %>" data-tab="users">
      <div class="zurion-section-block">
        <div class="zurion-admin__title">
          <h2><i class="fa-solid fa-users" style="margin-right:.6rem;color:var(--zurion-primary)"></i> Utilisateurs</h2>
          <span class="zurion-muted"><%= users.length %> inscrit(s)</span>
        </div>
        <% if (users.length) { %>
          <table class="zurion-table">
            <thead><tr><th>Nom</th><th>E-mail</th><th>Téléphone</th><th>Rôle</th><th>Créé le</th></tr></thead>
            <tbody>
              <% users.forEach(user => { %>
                <tr>
                  <td>
                    <div style="display:flex;align-items:center;gap:1rem">
                      <span class="zurion-account__avatar" style="width:3.6rem;height:3.6rem;font-size:1.4rem;margin:0"><%- esc((user.firstName || 'Z')[0].toUpperCase()) %></span>
                      <strong><%- esc(`${user.firstName} ${user.lastName}`) %></strong>
                    </div>
                  </td>
                  <td><%- esc(user.email) %></td>
                  <td><%- esc(user.phone || '—') %></td>
                  <td><span class="zurion-badge <%= user.role === 'admin' ? 'zurion-badge-info' : 'zurion-badge-success' %>"><%- esc(user.role) %></span></td>
                  <td><%= new Date(user.createdAt).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %><p class="zurion-muted">Aucun utilisateur inscrit.</p><% } %>
      </div>
    </section>

  </main>
</div>

<style>
.zurion-admin__tabs { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 2.4rem; border-bottom: 1px solid var(--zurion-border); padding-bottom: 1rem; }
.zurion-admin__tabs a { display: inline-flex; align-items: center; gap: .6rem; padding: .8rem 1.4rem; border-radius: var(--zurion-radius); font-weight: 600; font-size: 1.3rem; color: var(--zurion-body); border: 1px solid var(--zurion-border); background: #fff; transition: all .18s; }
.zurion-admin__tabs a:hover { border-color: var(--zurion-primary); color: var(--zurion-primary); }
.zurion-admin__tabs a.is-active { background: linear-gradient(120deg, var(--zurion-primary), #1d5d91); color: #fff; border-color: transparent; }
.zurion-admin__tab-panel { display: none; }
.zurion-admin__tab-panel.is-active { display: block; }
.zurion-stats--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
@media (max-width: 767px) { .zurion-admin__tabs { flex-direction: column; } .zurion-admin__tabs a { width: 100%; } .zurion-stats--3 { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 479px) { .zurion-stats--3 { grid-template-columns: 1fr; } }
</style>
